{
  "name": "general-licence-manager",
  "version": "2.0.0-dev.1",
  "private": true,
  "description": "A tool for managing the licences issued by municipalities.",
  "homepage": "https://github.com/cityssm/general-licence-manager#readme",
  "bugs": {
    "url": "https://github.com/cityssm/general-licence-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/general-licence-manager.git"
  },
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "type": "module",
  "exports": {
    ".": "./app.js"
  },
  "scripts": {
    "coverage": "cross-env NODE_ENV=dev DEBUG=general-licence-manager:* TEST_DATABASES=true c8 --reporter=lcov --reporter=text --reporter=text-summary mocha --timeout 30000 --exit",
    "cy:open": "cypress open --config-file cypress.config.js",
    "cy:run": "cypress run --config-file cypress.config.js",
    "dev:live": "cross-env NODE_ENV=dev DEBUG=general-licence-manager:* nodemon ./bin/www",
    "dev:test": "cross-env NODE_ENV=dev DEBUG=general-licence-manager:*,pdf-puppeteer:*,puppeteer-launch TEST_DATABASES=true nodemon ./bin/www",
    "start": "cross-env NODE_ENV=production node ./bin/www",
    "test": "cross-env NODE_ENV=dev DEBUG=general-licence-manager:* TEST_DATABASES=true mocha --timeout 30000 --exit"
  },
  "dependencies": {
    "@cityssm/authentication-helper": "^1.0.0",
    "@cityssm/bulma-js": "^0.5.0",
    "@cityssm/bulma-webapp-js": "^1.5.0",
    "@cityssm/configurator": "^0.2.0",
    "@cityssm/eft-generator": "^1.0.1",
    "@cityssm/expressjs-server-js": "^2.3.3",
    "@cityssm/get-canadian-bank-name": "^1.1.1",
    "@cityssm/modern-julian-date": "^1.0.3",
    "@cityssm/pdf-puppeteer": "^6.4.2",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "better-sqlite3": "^13.0.3",
    "camelcase": "^9.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "csurf": "^1.11.0",
    "debug": "^4.4.3",
    "ejs": "^6.0.1",
    "exit-hook": "^5.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "http-errors": "^2.0.1",
    "papaparse": "^5.7.0",
    "session-file-store": "^1.5.0",
    "slugify": "^1.6.9",
    "string-hash": "^1.1.3"
  },
  "devDependencies": {
    "@cityssm/bulma-webapp-css": "^0.12.0",
    "@cityssm/fa-glow": "^0.1.0",
    "@cityssm/mssql-multi-pool": "^5.1.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/debug": "^4.1.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/gulp": "^4.0.18",
    "@types/gulp-sass": "^6.0.0",
    "@types/http-errors": "^2.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node-windows": "^0.1.6",
    "@types/papaparse": "^5.5.2",
    "@types/session-file-store": "^1.2.6",
    "@types/string-hash": "^1.1.3",
    "cypress": "15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint-config-cityssm": "^50.0.0",
    "gulp": "^5.0.1",
    "gulp-sass": "^6.0.1",
    "nodemon": "^3.1.14",
    "prettier-config-cityssm": "^2.2.0",
    "sass": "^1.104.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "@fortawesome/fontawesome-free@5.15.4": true,
    "@parcel/watcher@2.6.0": true,
    "better-sqlite3@13.0.3": true,
    "registry-js@1.16.1": true,
    "win-version-info@6.0.1": true,
    "@cityssm/pdf-puppeteer@6.4.2": true,
    "puppeteer@25.7.0": true,
    "cypress@15.21.1": true
  }
}
